# Token do bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# Opcional: ID do seu servidor para os comandos aparecerem na hora (sem isso, comandos globais podem levar até 1h)
GUILD_ID=

# Quantos personagens populares do AniList entram no jogo (múltiplos de 50)
CHARACTER_POOL_SIZE=150
# Segundos que cada rodada dura
ROUND_SECONDS=30
# Pedaços necessários para a carta entrar no inventário
PIECES_TO_COMPLETE=4
